PROOFIX_HOST=127.0.0.1
PROOFIX_PORT=8000
PROOFIX_DATA_ROOT=.proofix-data
PROOFIX_ALLOWED_ROOTS=.proofix-data
# Public demo is disabled for local use. These flags are only for a restricted
# hosted demo and require both demo mode and the explicit public-demo flag.
# PROOFIX_DEMO=true
# PROOFIX_PUBLIC_DEMO=true
# PROOFIX_HOST=0.0.0.0
# Render supplies PORT; local use can keep PROOFIX_PORT=8000.
